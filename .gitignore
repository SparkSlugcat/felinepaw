# Python
__pycache__/
*.pyc
*.pyo

# 凭据与配置（切勿提交！）
config.json
fa_cookies.json
*_cookies.json
*.env
# 本机凭据快捷通道（FA 账号/密码），由 local_creds.py 读写。
# ⚠️ 这是「本地版 vs 上传版」的分界线：这个文件只存在于本机，别人克隆不到。
.faenv
# 浏览器身份随 cookie 一起导出（cf_clearance 绑它）
*_ua.txt
# 固定浏览器用户目录：里面存着通行证和登录态，等同于凭据
.fa_profile/

# 打包/构建产物
dist/
build/
*.spec
# 例外：GUI 的 PyInstaller 配方是仓库用户重新打包所必需的，必须提交
!sites/BBooru/gui/BBoorupaw.spec

# 第三方本地依赖目录
_dsp_env/
_pyi_env/
venv/
.venv/

# IDE
.idea/
.vscode/

# 日志与临时文件
*.log
*.part

# ---------- 下载产物（勿提交！）----------
# 各脚本不带 -o 直跑时会把图片下到 sites/ 或当前目录，这里用模式兜底。
# 注意：不要写 *.png —— assets/icon.png 是仓库合法资产；*.ico 同理（gui 图标）。
# 视频/图片扩展名：落在 sites/ 下的一律视为下载物
sites/**/*.png
sites/**/*.webp
sites/**/*.jpg
sites/**/*.jpeg
sites/**/*.gif
sites/**/*.mp4
sites/**/*.webm
# e-hentai：脚本生成的画廊目录 + 清单文件
sites/*/eh_*/
sites/*/eh_manifest.json
# 任何站点脚本生成的清单（e6_artist_manifest.json 等）—— 里面是真实作者名和作品 ID，
# 属于运行产物，不是仓库内容
*_manifest.json
# BBooru / WildDream：池目录与编号目录
sites/*/pool_*/
pool_*/
# 根目录下以编号命名的下载目录（WildDream 无 -o 直跑时会这样落）
/*/[0-9]/
# 说明：根目录下形如 诺瓦/ 这类"漫画名"目录无法用模式匹配 ——
# 跑 WildDream/BBooru 时请务必带 -o 指到图片库，不要留在仓库里。

# ---- 本机私有配置（绝不入库）----
.pawout

# ---- 本机专用启动器（钉死本机 conda 环境，别人的机器用不上）----
启动-本机.bat
